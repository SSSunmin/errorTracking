# 운영 docker-compose 환경변수 — 복사해서 infra/.env로 사용
# docker compose -f infra/docker-compose.yml --env-file infra/.env up -d --build

# DB
POSTGRES_USER=errortracking
POSTGRES_PASSWORD=__변경필수__
POSTGRES_DB=errortracking

# 세션 쿠키 서명 키 — 반드시 무작위 강한 값으로
SESSION_SECRET=__변경필수_무작위32바이트이상__
COOKIE_SECURE=true

# 외부 공개 주소 (대시보드 origin, DSN 표시, 알림 링크)
# 대시보드는 nginx 프록시로 same-origin이라 DASHBOARD_ORIGINS는 보통 비워도 됨
DASHBOARD_ORIGINS=https://errors.example.com
PUBLIC_BASE_URL=https://errors.example.com
DASHBOARD_URL=https://errors.example.com
HTTP_PORT=80

# 리버스 프록시(nginx) 홉 수 — req.ip 복원(rate limit 정확도). compose 기본 1
TRUST_PROXY=1

# 초기 admin 계정 (최초 기동 시 seed 별도 실행 필요 — 아래 배포 문서 참고)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=__변경필수__

# 이메일 알림 (선택) — 미설정 시 이메일 발송 비활성
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=errtrack@example.com
