# 대시보드 — vite 빌드 후 nginx로 정적 서빙 + /api 프록시
# 빌드 컨텍스트는 레포 루트 (compose에서 context: ..)
FROM node:22-alpine AS build

RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
# 빌드 시 CSP meta가 주입됨 (apps/dashboard/vite.config.ts)
RUN pnpm --filter @errortracking/dashboard build

FROM nginx:alpine
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/dashboard/dist /usr/share/nginx/html
EXPOSE 80
