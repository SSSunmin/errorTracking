# 복사해서 .env로 사용 — infra/docker-compose.dev.yml 기본값과 일치
DATABASE_URL=postgres://errortracking:errortracking@localhost:5432/errortracking

# 세션 쿠키 서명 키 — 운영에서는 반드시 무작위 값으로 교체
SESSION_SECRET=dev-session-secret-change-in-production

# seed 스크립트가 만드는 admin 계정
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=admin1234

# DSN 표시용 외부 노출 주소 (미설정 시 요청 host 사용)
# PUBLIC_BASE_URL=https://errors.example.com

# IP 주소 기록 정책 — 기본 미기록
# RECORD_IP=true
